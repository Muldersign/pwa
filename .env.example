# Copy to .env.local and fill in. Values are baked into the build (npm run build).

# --- Supabase (optional: sync between devices) -------------------------------
# Project Settings → API. The anon/publishable key is public by design;
# row level security in the database protects the data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI parsing (optional, needs a server that runs api/parse.ts) ------------
# VITE_AI_PARSE_ENDPOINT=/api/parse
# Server-side only, never prefix with VITE_:
# ANTHROPIC_API_KEY=
